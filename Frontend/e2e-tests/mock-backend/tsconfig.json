{
    "compilerOptions": {
        "target": "es2022",
        "module": "commonjs",
        "moduleResolution": "node",
        "lib": ["es2022"],
        "types": ["node"],
        "typeRoots": ["../../node_modules/@types"],
        "outDir": "../build/mock-backend",
        "rootDir": "./src",
        "sourceMap": true,
        "strict": true,
        "noImplicitOverride": true,
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts"]
}
